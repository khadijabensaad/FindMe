# ---- Existing configuration ----
URL_MONGO=mongodb://localhost:27017/findme
PORT=5000
CLOUDINARY_API_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SALT=10
NODEMAILER_API_USER=
NODEMAILER_API_PASS=
NET_SECRET=change-me

# ---- FINDME AI Stylist (LLM) ----
# Without these variables the stylist still works (rule-based understanding + templates).
# LLM_PROVIDER: "openai" = any OpenAI-compatible API, or "anthropic"
#
# Free / cheap options for a student project:
#   Groq   : LLM_BASE_URL=https://api.groq.com/openai/v1           LLM_MODEL=llama-3.3-70b-versatile
#   Gemini : LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   LLM_MODEL=gemini-2.0-flash
#   Ollama : LLM_BASE_URL=http://localhost:11434/v1  (no key)      LLM_MODEL=llama3.1
#   OpenAI : LLM_BASE_URL=https://api.openai.com/v1                LLM_MODEL=gpt-4o-mini
#   Claude : LLM_PROVIDER=anthropic                                 LLM_MODEL=claude-haiku-4-5
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
# Visual search needs a model that accepts images (e.g. gpt-4o-mini, gemini-2.0-flash,
# claude-haiku-4-5, or a llama vision model on Groq). Defaults to LLM_MODEL.
LLM_VISION_MODEL=
LLM_TIMEOUT_MS=20000
# Catalogue cache for the recommendation engine (ms)
CATALOG_CACHE_MS=60000

# Session length of the login token (default 7d)
JWT_EXPIRES_IN=7d
